# --- data ---
MERIDIAN_PROVIDER=auto          # auto | nasdaq | synthetic
NASDAQ_TIMEOUT_S=4
# --- LLM planner (optional; offline planner is used when empty) ---
ANTHROPIC_API_KEY=
MERIDIAN_MODEL=claude-sonnet-5-5
# --- execution ---
SANDBOX_BACKEND=local           # local | docker
SANDBOX_TIMEOUT_S=25
SANDBOX_MEM_MB=2048
MCP_TRANSPORT=inproc            # inproc | stdio
MERIDIAN_JOBS=thread            # thread | celery
REDIS_URL=redis://localhost:6379/0
# --- budgets ---
MAX_TOOL_CALLS=80
MAX_REPAIR_ATTEMPTS=3
CONTEXT_BUDGET_TOKENS=6000
MERIDIAN_DATA_DIR=./.meridian
